/*fread() has the neat feature where it returns 
the number of bytes read, or 0 on EOF. So we can 
loop until we see that, printing numbers as we go.*/

#include <stdio.h>

int main(void)
{
    FILE *fp;
    unsigned char c;

    fp = fopen("output.bin", "rb"); // rb for "read binary"!

    while (fread(&c, sizeof(char), 1, fp) > 0)
        printf("%d\n", c);

    fclose(fp);
}
